      m_Items: []
  - m_Id: 369426178617344
    m_Localized: Stell dich auf den ersten Kegel
    m_Metadata:
      m_Items: []
  - m_Id: 369575772663808
    m_Localized: Fahre auf den zweiten Kegel vor
    m_Metadata:
      m_Items: []
  - m_Id: 1516271344922624
    m_Localized: "Bewegen Sie sich seitw\xE4rts zum n\xE4chsten Kegel"
    m_Metadata:
      m_Items: []
  - m_Id: 1516637788680192
    m_Localized: Wende dich dem Kegel zu und gehe auf ihn zu.
    m_Metadata:
      m_Items: []
  - m_Id: 1518057824825344
    m_Localized: "Schlie\xDFlich wieder zur\xFCck zum n\xE4chsten Kegel"
    m_Metadata:
      m_Items: []
  - m_Id: 1518353359679488
    m_Localized: "Drehen Sie sich schlie\xDFlich um und gehen Sie auf den letzten
      Kegel zu."
    m_Metadata:
      m_Items: []
  - m_Id: 1518774287446016
    m_Localized: GUT GEMACHT
    m_Metadata:
      m_Items: []
  - m_Id: 1518970027225088
    m_Localized: "KEHREN SIE IN IHRE AUSGANGSPOSITION ZUR\xDCCK"
