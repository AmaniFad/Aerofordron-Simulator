  m_TableData:
  - m_Id: 22442216742649856
    m_Localized: "Lass die Drohne mit dem \u201Elinken Stick\u201C drehen, indem
      du ihn nach rechts und links bewegst."
    m_Metadata:
      m_Items: []
  - m_Id: 22442496670498816
    m_Localized: "Steuere die Drohne mit dem \u201Erechten Stick\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 22446732170952704
    m_Localized: "\u201EFPV\u201C-Modus"
    m_Metadata:
      m_Items: []
  - m_Id: 23144810423189504
    m_Localized: "Probieren Sie nun den \u201EFPV\u201C-Modus aus"
    m_Metadata:
      m_Items: []
  - m_Id: 23145191706394624
    m_Localized: "Dr\xFCcken Sie die Taste \u201EV\u201C, um den \u201EFPV\u201C-Modus
      aufzurufen."
    m_Metadata:
      m_Items: []
  - m_Id: 23145904960372736
    m_Localized: "Dr\xFCcken Sie die Taste oben auf der Fernbedienung, um den \u201EFPV\u201C-Modus
      aufzurufen."
    m_Metadata:
      m_Items: []
  - m_Id: 23146716205875200
    m_Localized: Kamera-Drehung
    m_Metadata:
      m_Items: []
  - m_Id: 23147542173384704
    m_Localized: "Jetzt drehen wir die Kamera \u2013 im \u201EFPV\u201C-Modus l\xE4sst
      sich das besser erkennen."
    m_Metadata:
      m_Items: []
  - m_Id: 23147850408591360
    m_Localized: "Dr\xFCcke die \u201ELinke Umschalttaste\u201C, um die Kamera nach
      oben zu drehen"
    m_Metadata:
      m_Items: []
  - m_Id: 23148003911729152
    m_Localized: "Dr\xFCcke die \u201ELinke Strg\u201C-Taste, um die Kamera nach
      unten zu drehen"
    m_Metadata:
      m_Items: []
  - m_Id: 23148132639113216
    m_Localized: "Drehe die Kamera mit dem \u201EAufw\xE4rtspfeil\u201C auf dem \u201EDPAD\u201C
      nach oben."
    m_Metadata:
      m_Items: []
  - m_Id: 23148280307974144
    m_Localized: "Drehe die Kamera mit dem \u201EAbw\xE4rtspfeil\u201C auf dem \u201EDPAD\u201C
      nach unten."
    m_Metadata:
      m_Items: []
