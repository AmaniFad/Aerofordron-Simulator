  - m_Id: 350670597500928
    m_Localized: 'Halten Sie 10 Meter Abstand! '
    m_Metadata:
      m_Items: []
  - m_Id: 355203180507136
    m_Localized: "<color=\"green\"><b>Stellen Sie sich </b></color>auf Augenh\xF6he
      mit dem Piloten, <color=\"green\"><b>5/10 m</b></color> von ihm entfernt."
    m_Metadata:
      m_Items: []
  - m_Id: 355540008284160
    m_Localized: "1.<color=\"green\"><b>Begeben Sie sich </b></color>in einer H\xF6he
      von <color=\"green\"><b>20 m bis 5 m</b></color> Entfernung zum Flugzeug."
    m_Metadata:
      m_Items: []
  - m_Id: 356272560254976
    m_Localized: "2. Entferne dich, indem du im Langsamflug einen <color=\"green\"><b>
      S </b></color> ausf\xFChrst (folge der Anleitung)"
    m_Metadata:
      m_Items: []
  - m_Id: 358176224817152
    m_Localized: "3.<color=\"green\"><b>Kehren Sie auf demselben Weg zur\xFCck</b></color>,
      indem Sie im Langsamflug eine <color=\"green\"><b>S</b></color> fliegen (folgen
      Sie der Anleitung)"
    m_Metadata:
      m_Items: []
  - m_Id: 358747015065600
    m_Localized: <color="green"><b>Sich entfernen</b></color>, bis auf <color="green"><b>40
      m
    m_Metadata:
      m_Items: []
  - m_Id: 358966431690752
    m_Localized: <color="green"><b>Sinkflug um 20 Meter</b></color> und halten Sie
      den Horizontalflug bei, bis Sie den Piloten erreichen
    m_Metadata:
      m_Items: []
  - m_Id: 359773575163904
    m_Localized: '<color="green"><b>Ort: </b></color> 30 Meter'
    m_Metadata:
      m_Items: []
  - m_Id: 359788452360192
    m_Localized: "Erstelle das <color=\"green\"><b>Rechteck</b></color>, ohne dabei
      <color=\"green\"><b>5 m/s</b></color> (18 km/h) zu \xFCberschreiten."
    m_Metadata:
      m_Items: []
  - m_Id: 360448434483200
    m_Localized: Start <color="green"><b>50 Meter
    m_Metadata:
      m_Items: []
  - m_Id: 360466671316992
    m_Localized: Land in der Gefahrenzone <color="green"><b>( H )
    m_Metadata:
      m_Items: []
  - m_Id: 361068692353024
