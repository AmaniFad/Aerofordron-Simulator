  - m_Id: 369426178617344
    m_Localized: "Place-toi au-dessus du premier c\xF4ne"
    m_Metadata:
      m_Items: []
  - m_Id: 369575772663808
    m_Localized: "Va vers le deuxi\xE8me c\xF4ne devant toi"
    m_Metadata:
      m_Items: []
  - m_Id: 1516271344922624
    m_Localized: "Lat\xE9ralement, va vers le c\xF4ne suivant"
    m_Metadata:
      m_Items: []
  - m_Id: 1516637788680192
    m_Localized: "Tourne vers le c\xF4ne et dirige-toi vers lui"
    m_Metadata:
      m_Items: []
  - m_Id: 1518057824825344
    m_Localized: "Enfin, recule jusqu\u2019au c\xF4ne suivant"
    m_Metadata:
      m_Items: []
  - m_Id: 1518353359679488
    m_Localized: "Enfin, tourne et va vers le dernier c\xF4ne"
    m_Metadata:
      m_Items: []
  - m_Id: 1518774287446016
    m_Localized: "BIEN JOU\xC9"
    m_Metadata:
      m_Items: []
  - m_Id: 1518970027225088
    m_Localized: "REVIENS \xC0 TA POSITION INITIALE"
    m_Metadata:
      m_Items: []
