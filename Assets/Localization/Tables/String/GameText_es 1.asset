    m_Metadata:
      m_Items: []
  - m_Id: 345874700283904
    m_Localized: Son
    m_Metadata:
      m_Items: []
  - m_Id: 346442231558144
    m_Localized: "Volume G\xE9n\xE9ral"
    m_Metadata:
      m_Items: []
  - m_Id: 346653892915200
    m_Localized: Volume Musique
    m_Metadata:
      m_Items: []
  - m_Id: 346770997882880
    m_Localized: Volume des Effets
    m_Metadata:
      m_Items: []
  - m_Id: 350670597500928
    m_Localized: "Reste \xE0 10 m\xE8tres !"
    m_Metadata:
      m_Items: []
  - m_Id: 355203180507136
    m_Localized: "<b>VOL STATIONNAIRE</b>\nPlace-toi \xE0 la hauteur des yeux du
      pilote, \xE0 une distance de 5 \xE0 10 m"
    m_Metadata:
      m_Items: []
  - m_Id: 355540008284160
    m_Localized: "<b>TRANSITION DE VOL</b>\nPlace-toi \xE0 une hauteur de 20 m, \xE0
      5 m de distance"
    m_Metadata:
      m_Items: []
  - m_Id: 356272560254976
    m_Localized: "<b>TRANSITION DE VOL</b>\n\xC9loigne-toi en volant lentement en
      forme de S \n(suis le guide)"
    m_Metadata:
      m_Items: []
  - m_Id: 358176224817152
    m_Localized: "<b>TRANSITION DE VOL</b>\nReviens par le m\xEAme chemin en volant
      lentement en forme de S \n(suis le guide)"
    m_Metadata:
      m_Items: []
  - m_Id: 358747015065600
    m_Localized: "<b>ASCENSION ET DESCENTE</b>\n\xC9loigne-toi en montant jusqu\u2019\xE0
      40 m"
    m_Metadata:
      m_Items: []
  - m_Id: 358966431690752
    m_Localized: "<b>ASCENSION ET DESCENTE</b>\nDescends de 20 m\xE8tres et maintiens
      un vol stabilis\xE9 jusqu\u2019au pilote"
    m_Metadata:
      m_Items: []
  - m_Id: 359773575163904
    m_Localized: "<b>CONTR\xD4LE DE LA VITESSE EN VOL</b>\nPlace-toi \xE0 30 m\xE8tres"
    m_Metadata:
      m_Items: []
  - m_Id: 359788452360192
    m_Localized: "<b>CONTR\xD4LE DE LA VITESSE EN VOL</b>\nEffectue le rectangle
      sans d\xE9passer les 18 km/h"
    m_Metadata:
      m_Items: []
  - m_Id: 360448434483200
    m_Localized: "<b>D\xC9COLLAGE ET ATTERRISSAGE</b>\nD\xE9colle sur 50 m\xE8tres"
    m_Metadata:
      m_Items: []
  - m_Id: 360466671316992
    m_Localized: "<b>D\xC9COLLAGE ET ATTERRISSAGE</b>\nAtterris dans la zone d\u2019urgence
      ( H )"
    m_Metadata:
      m_Items: []
  - m_Id: 361068692353024
    m_Localized: "<b>SIMULATION DE PANNE D\u2019UN MOTEUR</b>\nD\xE9colle sur 50
      m\xE8tres au-dessus de la zone d\u2019urgence"
    m_Metadata:
      m_Items: []
  - m_Id: 361092088180736
    m_Localized: "<b>SIMULATION DE PANNE D\u2019UN MOTEUR</b>\nDescente en spirale
      avec vitesse et reprise de contr\xF4le \u201Cbrusque\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 361707199639552
    m_Localized: "<b>SIMULATION DE PANNE DE COMMUNICATION</b>\nMonte \xE0 50 m\xE8tres
      et dirige-toi vers la for\xEAt en face."
    m_Metadata:
      m_Items: []
  - m_Id: 361772303626240
    m_Localized: "PERTE DE SIGNAL ! EX\xC9CUTE UN RTH"
    m_Metadata:
      m_Items: []
  - m_Id: 362532777078784
    m_Localized: "<b>GESTION DE SITUATION I</b>\nD\xE9colle et monte \xE0 50 m"
    m_Metadata:
      m_Items: []
  - m_Id: 362602515771392
    m_Localized: "<b>GESTION DE SITUACION I</b>\nReste \xE0 10 m\xE8tres du UAS jusqu\u2019\xE0
      la fin du temps"
    m_Metadata:
      m_Items: []
  - m_Id: 362627857756160
    m_Localized: "<b>GESTION DE SITUACION II</b>\nD\xE9colle et monte \xE0 50 m"
    m_Metadata:
      m_Items: []
  - m_Id: 364281436942336
    m_Localized: "<b>GESTION DE SITUACION I</b>\nAtterris dans la zone d\u2019urgence
      ( H )"
    m_Metadata:
      m_Items: []
  - m_Id: 364045729640448
    m_Localized: "<b>GESTION DE SITUACION II</b>\nReste \xE0 10 m\xE8tres de la personne
      jusqu\u2019\xE0 la fin du temps"
    m_Metadata:
      m_Items: []
  - m_Id: 364058652291072
    m_Localized: "<b>GESTION DE SITUACION II</b>\nAtterris dans la zone d\u2019urgence
      ( H )"
    m_Metadata:
      m_Items: []
