  - m_Id: 350670597500928
    m_Localized: "\xA1 Mantente a 10 metros !"
    m_Metadata:
      m_Items: []
  - m_Id: 355203180507136
    m_Localized: '<b>VUELO ESTACIONARIO</b>

      Colocate a la altura de los ojos
      del piloto a 5/10m de distancia del mismo'
    m_Metadata:
      m_Items: []
  - m_Id: 355540008284160
    m_Localized: "<b>TRANSICI\xD3N DE VUELO</b>\nColocate a la altura de 20m a 5m
      de distancia del mismo"
    m_Metadata:
      m_Items: []
  - m_Id: 356272560254976
    m_Localized: "<b>TRANSICI\xD3N DE VUELO</b>\nAlejate haciendo S en vuelo lento\n(sigue
      la guia)"
    m_Metadata:
      m_Items: []
  - m_Id: 358176224817152
    m_Localized: "<b>TRANSICI\xD3N DE VUELO</b>\nVuelve por el mismo camino haciendo
      S en vuelo lento\n(sigue la guia)"
    m_Metadata:
      m_Items: []
  - m_Id: 358747015065600
    m_Localized: '<b>ASCIENSO Y DESCENSO</b>

      Alejate subiendo hasta los 40m'
    m_Metadata:
      m_Items: []
  - m_Id: 358966431690752
    m_Localized: '<b>ASCIENSO Y DESCENSO</b>

      Desciende 20 metros y mantener
      el vuelo nivelado hasta llegar al piloto'
    m_Metadata:
      m_Items: []
  - m_Id: 359773575163904
    m_Localized: '<b>CONTROL DE LA VELOCIDAD EN VUELO</b>

      Colocate a 30 metros'
    m_Metadata:
      m_Items: []
  - m_Id: 359788452360192
    m_Localized: '<b>CONTROL DE LA VELOCIDAD EN VUELO</b>

      Realiza el rectangulo
      sin sobrepasar la los 18 km/h'
    m_Metadata:
      m_Items: []
  - m_Id: 360448434483200
    m_Localized: '<b>DESPEGUE Y ATERIZAGUE</b>

      Despega 50 metros'
    m_Metadata:
      m_Items: []
  - m_Id: 360466671316992
    m_Localized: '<b>DESPEGUE Y ATERIZAGUE</b>

      Aterriza en la zona de emergencia
      ( H ) '
    m_Metadata:
      m_Items: []
  - m_Id: 361068692353024
    m_Localized: "<b>SIMULACI\xD3N DE FALLO DE UN MOTOR</b>\nDespega 50 metros enciama
      de la zona de emergencia "
    m_Metadata:
      m_Items: []
  - m_Id: 361092088180736
    m_Localized: "<b>SIMULACI\xD3N DE FALLO DE UN MOTOR</b>\nDescenso en espiral
      con velocidad y toma \"dura\" de control"
    m_Metadata:
      m_Items: []
  - m_Id: 361707199639552
    m_Localized: "<b>SIMULACI\xD3N DE FALLO DE COMUNICACI\xD3N</b>\nAsciende 50 metros
      y dirigete hacia el bosque de enfrente."
    m_Metadata:
      m_Items: []
  - m_Id: 361772303626240
    m_Localized: "PERDIDA DE SE\xD1AL! EJECUTA UN RTH\n(pulsa R)"
    m_Metadata:
      m_Items: []
  - m_Id: 362532777078784
    m_Localized: "<b>GESTI\xD3N DE SITUACI\xD3N I</b>\nDespega y asciende a 50m"
    m_Metadata:
      m_Items: []
  - m_Id: 362602515771392
    m_Localized: "<b>GESTI\xD3N DE SITUACI\xD3N I</b>\nMantente a 10 metros de UAS
      hasta que finalice el tiempo"
    m_Metadata:
      m_Items: []
  - m_Id: 362627857756160
    m_Localized: "<b>GESTI\xD3N DE SITUACI\xD3N II</b>\nDespega y asciende a 50m"
    m_Metadata:
      m_Items: []
  - m_Id: 364281436942336
    m_Localized: "<b>GESTI\xD3N DE SITUACI\xD3N I</b>\nAterriza en la zona de emergencia
      ( H )"
    m_Metadata:
      m_Items: []
  - m_Id: 364045729640448
    m_Localized: "<b>GESTI\xD3N DE SITUACI\xD3N II</b>\nMantente a 10 metros de la
      persona hasta que finalice el tiempo"
    m_Metadata:
      m_Items: []
  - m_Id: 364058652291072
    m_Localized: "<b>GESTI\xD3N DE SITUACI\xD3N II</b>\nAterriza en la zona de emergencia
      (H)"
    m_Metadata:
      m_Items: []
