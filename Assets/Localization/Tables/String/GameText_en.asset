  - m_Id: 6930924616601600
    m_Localized: "Use W/A/S/D or \u2191/\u2193/\u2192/\u2190 to navigate the menu"
    m_Metadata:
      m_Items: []
  - m_Id: 6931490038140928
    m_Localized: Use the joystick to navigate the menu
