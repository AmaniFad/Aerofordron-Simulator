  - m_Id: 350670597500928
    m_Localized: 'Stay 10 meters away! '
    m_Metadata:
      m_Items: []
  - m_Id: 355203180507136
    m_Localized: <color="green"><b>Position yourself </b></color>at eye level with
      the pilot, <color="green"><b>5/10m</b></color> away from him.
    m_Metadata:
      m_Items: []
  - m_Id: 355540008284160
    m_Localized: 1.<color="green"><b>Position yourself </b></color>at a height of
      <color="green"><b>20m to 5m</b></color> away from the aircraft.
    m_Metadata:
      m_Items: []
  - m_Id: 356272560254976
    m_Localized: 2.Move away by doing an <color="green"><b> S </b></color> in slow
      flight (follow the guide)
    m_Metadata:
      m_Items: []
  - m_Id: 358176224817152
    m_Localized: 3.<color="green"><b>Return along</b></color> same patrh doing an
      <color="green"><b>S</b></color> in slow flight (follow the guide)
    m_Metadata:
      m_Items: []
  - m_Id: 358747015065600
    m_Localized: <color="green"><b>Move away</b></color>, climbing up to <color="green"><b>40m
    m_Metadata:
      m_Items: []
  - m_Id: 358966431690752
    m_Localized: <color="green"><b>Descent 20 meters</b></color> and maintain level
      flight until reaching the pilot
    m_Metadata:
      m_Items: []
  - m_Id: 359773575163904
    m_Localized: <color="green"><b>Place at</b></color> 30 meters
    m_Metadata:
      m_Items: []
  - m_Id: 359788452360192
    m_Localized: Make the <color="green"><b>rectangle</b></color> without exceeding
      <color="green"><b>5 m/s</b></color> (18 km/h)
    m_Metadata:
      m_Items: []
  - m_Id: 360448434483200
    m_Localized: Take off <color="green"><b>50 meters
    m_Metadata:
      m_Items: []
  - m_Id: 360466671316992
    m_Localized: Land in the emergency zone <color="green"><b>( H )
    m_Metadata:
      m_Items: []
  - m_Id: 361068692353024
    m_Localized: <color="green"><b>Take off 50</b></color> meters above the emergency
      zone
    m_Metadata:
      m_Items: []
  - m_Id: 361092088180736
    m_Localized: <color="green"><b>Spiral</b></color> descent with speed and "hard"
      takeover
    m_Metadata:
      m_Items: []
  - m_Id: 361707199639552
    m_Localized: <color="green"><b>Ascend 50 meters</b></color> and head toward the
      forest ahead.
    m_Metadata:
      m_Items: []
  - m_Id: 361772303626240
    m_Localized: "SIGNAL LOSS! RUN <color=\"green\"><b>RTH \n"
    m_Metadata:
      m_Items: []
  - m_Id: 362532777078784
    m_Localized: "\r2.<color=\"green\"><b>Take off</b></color> and ascent <color=\"green\"><b>50m"
    m_Metadata:
      m_Items: []
  - m_Id: 362602515771392
    m_Localized: 2.<color="green"><b>Stay 10 meters</b></color> away from the UAS
      until the timer expires
    m_Metadata:
      m_Items: []
